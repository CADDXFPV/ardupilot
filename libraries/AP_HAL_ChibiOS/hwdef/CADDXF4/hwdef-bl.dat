# hw definition file for the CADDXF4 bootloader

MCU STM32F4xx STM32F405xx

APJ_BOARD_ID AP_HW_CADDXF4

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024

FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 48

SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Hold all SPI devices deselected during boot.
PA4 GYRO1_CS CS
PB12 OSD1_CS CS
PA15 FLASH1_CS CS

PC15 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0
