# hw definition file for CADDXF4 hardware
# Pin mapping is based on the Betaflight CADDXF4 target.

MCU STM32F4xx STM32F405xx

APJ_BOARD_ID AP_HW_CADDXF4

OSCILLATOR_HZ 8000000
STM32_VDD 330U

define STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 48

define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1

# USB and serial ports
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 USART6

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PB6 USART1_TX USART1
PB7 USART1_RX USART1

PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2 NODMA
PC0 USART2_RXINV OUTPUT LOW GPIO(78) POL(1)
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN

PB10 USART3_TX USART3
PB11 USART3_RX USART3 NODMA

PA0 UART4_TX UART4
PA1 UART4_RX UART4 NODMA

PC12 UART5_TX UART5
PD2 UART5_RX UART5 NODMA

PC6 USART6_TX USART6
PC7 USART6_RX USART6

# I2C bus for onboard barometer and external compass
I2C_ORDER I2C1
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

# SPI1 - IMU
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 GYRO1_CS CS
PC4 GYRO1_DRDY INPUT

# SPI2 - MAX7456 OSD
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PB12 OSD1_CS CS

# SPI3 - W25Q128 dataflash
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3
PA15 FLASH1_CS CS

# Analog battery monitoring
PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC3 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_CURR_PIN 13
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 100.0
define HAL_BATT_MONITOR_DEFAULT 4

# Buzzer and status LEDs are active low
PC13 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80

define AP_NOTIFY_GPIO_LED_1_ENABLED 1
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PC15 LED0 OUTPUT LOW GPIO(90)
PC14 LED1 OUTPUT LOW GPIO(91)
define AP_NOTIFY_GPIO_LED_1_PIN 90
define AP_NOTIFY_GPIO_LED_2_PIN 91
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91

# Betaflight PINIO outputs
PC2 PINIO1 OUTPUT GPIO(81) LOW
PC5 PINIO2 OUTPUT GPIO(82) LOW
define RELAY1_PIN_DEFAULT 81
define RELAY2_PIN_DEFAULT 82

# Motor outputs retain the Betaflight motor numbering
PC8  TIM8_CH3 TIM8 PWM(1) GPIO(50)       # M1
PC9  TIM8_CH4 TIM8 PWM(2) GPIO(51)       # M2
PA8  TIM1_CH1 TIM1 PWM(3) GPIO(52)       # M3
PA9  TIM1_CH2 TIM1 PWM(4) GPIO(53) BIDIR # M4
PA10 TIM1_CH3 TIM1 PWM(5) GPIO(54) BIDIR # M5
PB4  TIM3_CH1 TIM3 PWM(6) GPIO(55)       # M6
PB0  TIM3_CH3 TIM3 PWM(7) GPIO(56)       # M7
PB1  TIM3_CH4 TIM3 PWM(8) GPIO(57) BIDIR # M8

# WS2812 LED strip
PB3 TIM2_CH2 TIM2 PWM(9) GPIO(58)
define HAL_NEOPIXEL_COUNT 8

# The fitted IMU varies between board revisions. Invensensev3 probes
# ICM42688P, ICM42670P and ICM40609D using the same SPI device entry.
SPIDEV imu_inv3 SPI1 DEVID1 GYRO1_CS MODE3 2*MHZ 16*MHZ
SPIDEV imu_mpu6000 SPI1 DEVID1 GYRO1_CS MODE3 1*MHZ 8*MHZ
SPIDEV imu_bmi270 SPI1 DEVID1 GYRO1_CS MODE3 1*MHZ 10*MHZ
SPIDEV imu_lsm6dsv16x SPI1 DEVID1 GYRO1_CS MODE3 2*MHZ 10*MHZ

IMU Invensensev3 SPI:imu_inv3 ROTATION_YAW_90
IMU Invensense SPI:imu_mpu6000 ROTATION_YAW_90
IMU BMI270 SPI:imu_bmi270 ROTATION_YAW_90
IMU LSM6DSV16X SPI:imu_lsm6dsv16x ROTATION_YAW_90

define HAL_DEFAULT_INS_FAST_SAMPLE 3

# Onboard barometer variants
BARO BMP280 I2C:0:0x76
BARO DPS310 I2C:0:0x76
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_BMP280_ENABLED 1
define AP_BARO_DPS280_ENABLED 1

# External compass support on I2C1
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# W25Q128 blackbox flash
SPIDEV dataflash SPI3 DEVID1 FLASH1_CS MODE3 32*MHZ 32*MHZ
define HAL_LOGGING_DATAFLASH_ENABLED 1
define HAL_LOGGING_DATAFLASH_DRIVER AP_Logger_Flash_JEDEC

# Analog OSD
SPIDEV osd SPI2 DEVID2 OSD1_CS MODE0 10*MHZ 10*MHZ
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

DMA_NOSHARE TIM1_UP TIM3_UP TIM8_UP SPI1*
DMA_PRIORITY TIM1_UP TIM2_UP TIM3_UP TIM8_UP SPI1* SPI3*

# Betaflight/X motor order for standard quad frames
define HAL_FRAME_TYPE_DEFAULT 12
define DEFAULT_NTF_LED_TYPES 257

include ../include/minimize_fpv_osd.inc
AUTOBUILD_TARGETS Copter
